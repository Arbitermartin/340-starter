<div class="form-wrapper-01" id="addNewsForm">
    <div class="form-header">
      <h1>Add New News Article</h1>
      <p>Share important updates with the UHWF community</p>
    </div>
  
    <% if (messages.success) { %>
      <div class="alert success"><%= messages.success %></div>
    <% } %>
    <% if (messages.notice || messages.error) { %>
      <div class="alert error"><%= messages.notice || messages.error %></div>
    <% } %>

  
          <form action="/account/inventory/team/add"
                method="POST"
                enctype="multipart/form-data"
                class="form-group-01">
  
            <div class="from-group-01">
              <div class="t-fg">
                <label>Full Name <span class="req">*</span></label>
                <input type="text" name="full_name"
                       placeholder="e.g. Rogasian C Simon" required/>
              </div>
              <div class="from-group-01">
                <label>Position / Title <span class="req">*</span></label>
                <input type="text" name="position"
                       placeholder="e.g. CEO & Co-founder" required/>
              </div>
            </div>
  
            <div class="from-group-01">
              <label>Description</label>
              <textarea name="description" rows="3"
                placeholder="Brief bio about this team member..."></textarea>
            </div>
  
            <div class="from-group-01">
              <label>Profile Photo</label>
              <input type="file" name="profile_image" accept="image/*"/>
              <small style="color:#888;font-size:0.75rem;display:block;margin-top:4px;">
                JPG, PNG, WebP — max 5MB
              </small>
            </div>
  
            <div style="background:#f8faf8;border:1px solid #e0e4e2;border-radius:10px;padding:1.1rem;margin-bottom:1rem;">
              <p style="font-size:0.78rem;font-weight:700;text-transform:uppercase;letter-spacing:0.07em;color:#2e7d32;margin-bottom:0.75rem;">
                <i class="bi bi-share-fill"></i> Social Links (optional)
              </p>
              <div class="t-row2">
                <div class="from-group-01">
                  <label><i class="fab fa-linkedin-in"></i> LinkedIn URL</label>
                  <input type="url" name="linkedin_url" placeholder="https://linkedin.com/in/..."/>
                </div>
                <div class="t-fg">
                  <label><i class="fab fa-twitter"></i> Twitter URL</label>
                  <input type="url" name="twitter_url" placeholder="https://twitter.com/..."/>
                </div>
              </div>
              <div class="t-row2">
                <div class="t-fg">
                  <label><i class="fab fa-instagram"></i> Instagram URL</label>
                  <input type="url" name="instagram_url" placeholder="https://instagram.com/..."/>
                </div>
                <div class="t-fg">
                  <label><i class="fas fa-envelope"></i> Email</label>
                  <input type="email" name="email_url" placeholder="name@uhwf.org"/>
                </div>
              </div>
            </div>
  
            <div class="t-fg" style="max-width:200px;">
              <label>Display Order</label>
              <input type="number" name="display_order" value="0" min="0"/>
              <small style="color:#888;font-size:0.75rem;">Lower number shows first</small>
            </div>
  
            <div class="t-fa">
              <a href="/account/inventory/team" class="t-btn t-btn-gray">Cancel</a>
              <button type="submit" class="t-btn t-btn-green">
                <i class="bi bi-person-plus-fill"></i> Add Team Member
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>