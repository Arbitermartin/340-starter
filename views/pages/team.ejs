<main class="team-page">
    <section class="hero-section">
      <div class="hero-overlay"></div>
      <div class="hero-content">
        <h1>Meet Our Expert Team</h1>
        <p>Passionate professionals dedicated to serving you with excellence</p>
      </div>
    </section>
  
   <!-- TEAM -->
   <section class="team-section">
    <div class="section-header">
      <h2>Our Leadership</h2>
      <p>Committed professionals driving our mission forward with passion and expertise.</p>
    </div>

    <div class="team-grid">

      <% if (typeof teamMembers !== 'undefined' && teamMembers && teamMembers.length > 0) { %>

        <% teamMembers.forEach((member, index) => { %>
          <div class="team-card" data-aos="fade-up" data-aos-delay="<%= index * 80 %>">

            <!-- Photo -->
            <div class="team-image">
              <% if (member.profile_image) { %>
                <img src="<%= member.profile_image %>"
                     alt="<%= member.full_name %>"
                     loading="lazy"/>
              <% } else { %>
                <div class="no-photo">
                  <i class="bi bi-person-fill"></i>
                </div>
              <% } %>

              <!-- Social overlay on hover -->
              <div class="social-overlay">
                <% if (member.linkedin_url) { %>
                  <a href="<%= member.linkedin_url %>"
                     target="_blank" rel="noopener" aria-label="LinkedIn">
                    <i class="fab fa-linkedin-in"></i>
                  </a>
                <% } %>
                <% if (member.twitter_url) { %>
                  <a href="<%= member.twitter_url %>"
                     target="_blank" rel="noopener" aria-label="Twitter">
                    <i class="fab fa-twitter"></i>
                  </a>
                <% } %>
                <% if (member.instagram_url) { %>
                  <a href="<%= member.instagram_url %>"
                     target="_blank" rel="noopener" aria-label="Instagram">
                    <i class="fab fa-instagram"></i>
                  </a>
                <% } %>
                <% if (member.email_url) { %>
                  <a href="mailto:<%= member.email_url %>" aria-label="Email">
                    <i class="fas fa-envelope"></i>
                  </a>
                <% } %>
              </div>
            </div>

            <!-- Info -->
            <div class="team-info">
              <h3><%= member.full_name %></h3>
              <span class="position"><%= member.position %></span>
              <% if (member.description) { %>
                <p><%= member.description %></p>
              <% } %>
            </div>

          </div>
        <% }) %>

      <% } else { %>
        <div class="team-empty">
          <i class="bi bi-people"></i>
          <p>No team members to display yet.</p>
        </div>
      <% } %>

    </div>
  </section>
    <section class="values-section">
        <h2>Our Core Values</h2>
      <div class="container">
       
        <div class="values-grid">
          <div class="value-item">
            <i class="fas fa-handshake"></i>
            <h4>Integrity</h4>
            <p>We live the principles that we expect others to follow. We conduct ourselves with
              integrity, responsibility, and transparency, and we rely on facts and research to guide
              us and ensure that we learn and grow.</p>
          </div>
          <div class="value-item">
            <i class="fas fa-star"></i>
            <h4>Excellence</h4>
            <p>Committed to delivering the highest quality service</p>
          </div>
          <div class="value-item">
            <i class="fas fa-users"></i>
            <h4>Family</h4>
            <p>We treat every customer and team member like family</p>
          </div>
        </div>
      </div>
    </section>
  </main>